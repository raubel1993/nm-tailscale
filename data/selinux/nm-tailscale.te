# SELinux policy module for nm-tailscale-service.
#
# NetworkManager spawns VPN plugins in its own domain (NetworkManager_t).
# The plugin must reach the tailscaled control socket, which Fedora labels
# var_run_t, and connect to the tailscaled process (unconfined_service_t).
# Observed denial (Fedora 44, selinux-policy-targeted 44.11):
#   avc: denied { write } comm="nm-tailscale-se" name="tailscaled.sock"
#        scontext=system_u:system_r:NetworkManager_t:s0
#        tcontext=system_u:object_r:var_run_t:s0 tclass=sock_file
module nm_tailscale 1.0;

require {
    type NetworkManager_t;
    type var_run_t;
    type unconfined_service_t;
    class sock_file write;
    class unix_stream_socket connectto;
}

allow NetworkManager_t var_run_t:sock_file write;
allow NetworkManager_t unconfined_service_t:unix_stream_socket connectto;
