%global selinuxtype targeted
%global modulename nm_tailscale

Name:           nm-tailscale
Version:        0.1.0
Release:        1%{?dist}
Summary:        NetworkManager VPN plugin for Tailscale

License:        GPL-2.0-or-later
URL:            https://github.com/raubel1993/nm-tailscale
Source0:        %{name}-%{version}.tar.gz
# Generated by `make dist` (go mod vendor). Builds have no network access.
Source1:        %{name}-%{version}-vendor.tar.gz

BuildRequires:  golang >= 1.24
BuildRequires:  go-rpm-macros
BuildRequires:  selinux-policy-devel

Requires:       NetworkManager
Recommends:     tailscale
Requires:       (%{name}-selinux = %{version}-%{release} if selinux-policy-%{selinuxtype})

%description
A NetworkManager VPN service plugin for Tailscale. Each Tailscale account is
an ordinary NetworkManager VPN connection that appears in the GNOME system
menu and network settings. The plugin asks tailscaled, through its LocalAPI,
which profile to run and whether the tunnel should be up.

NetworkManager reads plugin descriptors at start; restart NetworkManager after
installing or removing this package.

%package        selinux
Summary:        SELinux policy module for %{name}
BuildArch:      noarch
Requires:       selinux-policy-%{selinuxtype}
Requires(post): selinux-policy-%{selinuxtype}
Requires(post): policycoreutils

%description    selinux
SELinux policy module %{modulename} that lets NetworkManager reach the
tailscaled control socket, as required by %{name} on Fedora.

%prep
%autosetup -n %{name}-%{version} -a 1

%build
export GO111MODULE=on
export GOFLAGS=-mod=vendor
%gobuild -o %{gobuilddir}/bin/nm-tailscale-service ./cmd/nm-tailscale-service

# SELinux module. Unverified outside Fedora build roots: the devel Makefile
# expects the .te file to be named after the module.
mkdir selinux-build
cp data/selinux/nm-tailscale.te selinux-build/%{modulename}.te
make -C selinux-build -f %{_datadir}/selinux/devel/Makefile %{modulename}.pp
bzip2 -9 selinux-build/%{modulename}.pp

%install
install -D -p -m 0755 %{gobuilddir}/bin/nm-tailscale-service \
    %{buildroot}%{_libexecdir}/nm-tailscale-service
install -D -p -m 0644 data/nm-tailscale-service.name \
    %{buildroot}%{_prefix}/lib/NetworkManager/VPN/nm-tailscale-service.name
install -D -p -m 0644 data/nm-tailscale-service.conf \
    %{buildroot}%{_datadir}/dbus-1/system.d/nm-tailscale-service.conf
install -D -p -m 0644 selinux-build/%{modulename}.pp.bz2 \
    %{buildroot}%{_datadir}/selinux/packages/%{selinuxtype}/%{modulename}.pp.bz2

%files
%license LICENSE
%doc README.md CHANGELOG.md
%{_libexecdir}/nm-tailscale-service
%{_prefix}/lib/NetworkManager/VPN/nm-tailscale-service.name
%{_datadir}/dbus-1/system.d/nm-tailscale-service.conf

%files selinux
%license LICENSE
%{_datadir}/selinux/packages/%{selinuxtype}/%{modulename}.pp.bz2
%ghost %verify(not md5 size mode mtime) %{_sharedstatedir}/selinux/%{selinuxtype}/active/modules/200/%{modulename}

%pre selinux
%selinux_relabel_pre -s %{selinuxtype}

%post selinux
%selinux_modules_install -s %{selinuxtype} %{_datadir}/selinux/packages/%{selinuxtype}/%{modulename}.pp.bz2
%selinux_relabel_post -s %{selinuxtype}

%postun selinux
if [ $1 -eq 0 ]; then
    %selinux_modules_uninstall -s %{selinuxtype} %{modulename}
    %selinux_relabel_post -s %{selinuxtype}
fi

%changelog
* Fri Oct 23 2026 Maintainer <maintainer@example.com> - 0.1.0-1
- Initial package
